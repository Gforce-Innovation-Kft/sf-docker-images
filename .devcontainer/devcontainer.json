{
  "name": "Salesforce Development (sf-devcontainer)",
  "build": {
    "context": "../sf-devcontainer",
    "dockerfile": "../sf-devcontainer/Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "vscode",
  "overrideCommand": true,
  "features": {
    // AI pair development — remove this line if you don't use Claude Code
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    // Persistent zsh history across container rebuilds (picked up by .zshrc)
    "source=sf-devcontainer-history,target=/commandhistory,type=volume",
    // Persistent SF CLI org auth across rebuilds. These are named Docker
    // volumes (container-native storage), NOT a bind mount of your host
    // ~/.sf or ~/.sfdx — bind-mounting host auth files here causes
    // `AuthDecryptError` on `sf org list`, because they were encrypted with
    // your host OS's keychain, which this Linux container can't read.
    // Auth into these volumes from *inside* the container instead — see
    // examples/scripts/auth-org.sh / examples/.env.example (SF_AUTH_URL) —
    // and it will survive rebuilds without ever touching host-encrypted files.
    "source=sf-devcontainer-sf-config,target=/home/vscode/.sf,type=volume",
    "source=sf-devcontainer-sfdx-config,target=/home/vscode/.sfdx,type=volume"
    // Reuse your host Claude Code auth/settings (requires ~/.claude on the host):
    // "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "salesforce.salesforcedx-vscode-expanded",
        "chuckjonas.apex-pmd",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "salesforcedx-vscode-core.telemetry.enabled": false
      }
    }
  },
  "postCreateCommand": "sudo chown vscode:vscode /commandhistory 2>/dev/null; sf version --verbose || true"
}
