{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker image inspect:*)",
      "Bash(pytest:*)",
      "Bash(pip install:*)",
      "Bash(yamllint:*)",
      "Bash(gh run:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/governance/session-report.mjs"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gforce-ai": {
      "source": {
        "source": "github",
        "repo": "Gforce-Innovation-Kft/gforce-ai",
        "ref": "v0.1.0"
      }
    }
  },
  "enabledPlugins": {
    "gforce-guardrails gforce-core gforce-github gforce-gcp@gforce-ai": true
  }
}
